<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aurora_canvas"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/titulo_agregar_contacto"
            android:textAppearance="@style/TextAppearance.TP6.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/descripcion_agregar_contacto"
            android:textAppearance="@style/TextAppearance.TP6.PageSubtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_aurora_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/nombre"
                android:textAppearance="@style/TextAppearance.TP6.FieldLabel" />

            <EditText
                android:id="@+id/etNombre"
                style="@style/Widget.TP6.EditText.Aurora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/hint_nombre"
                android:inputType="textPersonName" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/apellido"
                android:textAppearance="@style/TextAppearance.TP6.FieldLabel" />

            <EditText
                android:id="@+id/etApellido"
                style="@style/Widget.TP6.EditText.Aurora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/hint_apellido"
                android:inputType="textPersonName" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/telefono"
                android:textAppearance="@style/TextAppearance.TP6.FieldLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etTelefono"
                    style="@style/Widget.TP6.EditText.Aurora"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:hint="@string/hint_telefono"
                    android:inputType="phone" />

                <Spinner
                    android:id="@+id/spTipoTelefono"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_aurora_spinner"
                    android:minWidth="112dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/email"
                android:textAppearance="@style/TextAppearance.TP6.FieldLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etEmail"
                    style="@style/Widget.TP6.EditText.Aurora"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress" />

                <Spinner
                    android:id="@+id/spTipoEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_aurora_spinner"
                    android:minWidth="112dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/direccion"
                android:textAppearance="@style/TextAppearance.TP6.FieldLabel" />

            <EditText
                android:id="@+id/etDireccion"
                style="@style/Widget.TP6.EditText.Aurora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/hint_direccion"
                android:inputType="textPostalAddress" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/fecha_de_nacimiento"
                android:textAppearance="@style/TextAppearance.TP6.FieldLabel" />

            <EditText
                android:id="@+id/etFechaNacimiento"
                style="@style/Widget.TP6.EditText.Aurora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_calendar"
                android:drawablePadding="12dp"
                android:focusable="false"
                android:hint="@string/hint_fecha_nacimiento" />

        </LinearLayout>

        <Button
            android:id="@+id/btnContinuar"
            style="@style/Widget.TP6.Button.Aurora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/continuar" />

    </LinearLayout>
</ScrollView>